# CrashGuard AI Environment Configuration
# Copy this file to assets/.env and fill in values for local development.
# NEVER commit real secrets to the repository.
# In production: use --dart-define=KEY=VALUE in your CI/CD pipeline.

# ── Supabase ───────────────────────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# PowerSync (offline sync) — from PowerSync Dashboard
POWERSYNC_URL=

# ── Gemma 4 AI (via Google AI Studio) ─────────────────────────────────────────
# The app uses Gemma 4 (open-weight model) for emergency triage.
# Cloud inference: Supabase Edge Functions hold this key server-side.
# Mobile clients NEVER hold this key directly.
#
# Set GEMMA_API_KEY as a Supabase Edge Function secret:
#   supabase secrets set GEMMA_API_KEY=your_key_here
#
# Get your key: https://aistudio.google.com/app/apikey
# Models used:
#   - Cloud (edge fn): gemma-4-27b-it  (falls back to gemma-3-27b-it)
#   - On-device:       gemma-4-e4b-it  (via flutter_gemma / LiteRT)
# GEMMA_API_KEY=  ← set in Supabase secrets, NOT here

# ── SMS Dispatch (Twilio — server-side, no user interaction required) ──────────
# Set these as Supabase Edge Function secrets for the sms-dispatch function.
# TWILIO_ACCOUNT_SID=   ← set in Supabase secrets
# TWILIO_AUTH_TOKEN=    ← set in Supabase secrets
# TWILIO_FROM_NUMBER=   ← e.g. +1234567890, set in Supabase secrets

# Optional: override emergency number (default: 112 / 911 based on locale)
# EMERGENCY_NUMBER_OVERRIDE=112

# ── India-specific dispatch ────────────────────────────────────────────────────
# Optional: State ERSS webhook (if enrolled with state emergency services)
# INDIA_ERSS_WEBHOOK_URL=
# INDIA_ERSS_API_KEY=

# Auto-dial 108 (India ambulance) after SOS — true by default
# INDIA_AUTO_DIAL_AMBULANCE=true

# ── Map tiles ─────────────────────────────────────────────────────────────────
# Use a self-hosted or commercial tile provider at scale (OSM ToS forbids mass usage).
# Example: MAP_TILE_URL_TEMPLATE=https://tile.mapbox.com/.../{z}/{x}/{y}.png
# MAP_TILE_URL_TEMPLATE=

# ── SMS relay (legacy — prefer sms-dispatch Supabase edge function) ────────────
# SMS_DISPATCH_URL=
# SMS_DISPATCH_ANON_KEY=
# SMS_RELAY_COUNTS_AS_PRIMARY_DISPATCH=false
