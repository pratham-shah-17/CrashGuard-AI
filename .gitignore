# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
# Cursor — version shared rules/skills/agents/hooks; ignore local-only junk
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**
!.cursor/agents/
!.cursor/agents/**
!.cursor/hooks.json
!.cursor/environment.json
!.cursor/setup.sh
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Bolt / Jules workspace files
.jules/

# Graphify tool output (regenerable via `graphify update .`)
graphify-out/

# Local developer secrets (root only; committed template is assets/.env)
/.env

# Supabase CLI transient state (version cache, local stack metadata)
supabase/.temp/
supabase/.branches/
